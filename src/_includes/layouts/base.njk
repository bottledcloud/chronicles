<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ metaDescription or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ site.url }}/feed.xml">

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ metaDescription or site.description }}">
  <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary">

  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=Spectral:ital,wght@0,300;0,400;1,300&family=Gantari:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}">
</head>
<body>

<nav>
  <a class="nav-mark" href="{{ '/' | url }}"><svg class="chimp-mark" viewBox="0 0 100 100" aria-hidden="true"><path d="M50,14 C30,14 17,30 17,48 C17,39 10,36 7,41 C4,46 7,54 15,56 C17,76 31,89 50,89 C69,89 83,76 85,56 C93,54 96,46 93,41 C90,36 83,39 83,48 C83,30 70,14 50,14 Z" fill="currentColor"/><path d="M50,32 C40,32 32,40 31,51 C29,64 38,74 50,74 C62,74 71,64 69,51 C68,40 60,32 50,32 Z" fill="var(--paper, #faf4e6)"/><path d="M39,52 q5,3.5 10,0" stroke="currentColor" stroke-width="3.5" fill="none" stroke-linecap="round"/><path d="M55,52 q5,3.5 10,0" stroke="currentColor" stroke-width="3.5" fill="none" stroke-linecap="round"/><path d="M44,66 q6,4 12,0" stroke="currentColor" stroke-width="3.5" fill="none" stroke-linecap="round"/><path d="M50,2 l3,6 6,3 -6,3 -3,6 -3,-6 -6,-3 6,-3 Z" fill="#e8a33d"/></svg>&nbsp; {{ site.name }}</a>
  <div class="nav-links">
    <a href="{{ '/' | url }}#archive">Chronicle</a>
    <a href="{{ '/' | url }}#about">About</a>
    <a href="{{ '/feed.xml' | url }}">RSS</a>
  </div>
</nav>

{{ content | safe }}

<footer id="subscribe">
  <svg class="chimp-foot" viewBox="0 0 100 100" aria-hidden="true"><path d="M50,14 C30,14 17,30 17,48 C17,39 10,36 7,41 C4,46 7,54 15,56 C17,76 31,89 50,89 C69,89 83,76 85,56 C93,54 96,46 93,41 C90,36 83,39 83,48 C83,30 70,14 50,14 Z" fill="#2d5a3d"/><path d="M50,32 C40,32 32,40 31,51 C29,64 38,74 50,74 C62,74 71,64 69,51 C68,40 60,32 50,32 Z" fill="#faf4e6"/><path d="M39,52 q5,3.5 10,0" stroke="#2d5a3d" stroke-width="3.5" fill="none" stroke-linecap="round"/><path d="M55,52 q5,3.5 10,0" stroke="#2d5a3d" stroke-width="3.5" fill="none" stroke-linecap="round"/><path d="M44,66 q6,4 12,0" stroke="#2d5a3d" stroke-width="3.5" fill="none" stroke-linecap="round"/><path d="M50,2 l3,6 6,3 -6,3 -3,6 -3,-6 -6,-3 6,-3 Z" fill="#e8a33d"/></svg>
  <h3>Wait for the fireflies</h3>
  <p class="sub-note">Follow by RSS — one entry at a time, nothing else.</p>
  <div class="sub-row">
    <a href="{{ '/feed.xml' | url }}">Subscribe via RSS</a>
  </div>
  <p class="dedication">for Amma — <a href="{{ '/2018/03/21/mother/' | url }}">where it all began</a></p>
  <div class="foot-meta">{{ site.name }} · since 2018 · grown from memory</div>
</footer>

<script src="{{ '/assets/enhance.js' | url }}" defer></script>
</body>
</html>
