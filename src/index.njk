---
layout: layouts/base.njk
permalink: /
---
<header>
  <canvas id="fireflies" aria-hidden="true"></canvas>
  <svg class="treeline" viewBox="0 0 1200 70" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,70 C60,28 140,52 220,34 C300,16 360,48 440,30 C520,12 600,44 680,26 C760,10 840,42 920,28 C1000,14 1080,46 1200,24 L1200,70 Z" fill="#faf4e6"/>
  </svg>
  <svg class="treeline-chimp" viewBox="0 0 120 110" aria-hidden="true">
    <path d="M60,10 C46,10 37,21 37,33 C37,27 32,25 30,28 C28,31 30,37 36,38 C37,52 47,61 60,61 C73,61 83,52 84,38 C90,37 92,31 90,28 C88,25 83,27 83,33 C83,21 74,10 60,10 Z" fill="#1f4230"/>
    <path d="M44,58 C36,64 31,74 31,86 L37,108 L83,108 L89,86 C89,74 84,64 76,58 C71,62 65,64 60,64 C55,64 49,62 44,58 Z" fill="#1f4230"/>
    <path d="M31,86 C24,80 20,72 20,64 C26,68 31,74 33,80 Z" fill="#1f4230"/>
    <path d="M89,86 C96,80 100,72 100,64 C94,68 89,74 87,80 Z" fill="#1f4230"/>
    <circle cx="104" cy="30" r="3.5" fill="#ffd98c"/>
    <circle cx="104" cy="30" r="9" fill="#ffd98c" opacity=".25"/>
  </svg>
  <div class="hero-inner">
    <div class="hero-eyebrow">✶ &nbsp;a garden of what remains&nbsp; ✶</div>
    <h1>The Stoned Chimp's<br><em>Chronicles</em></h1>
    <p class="hero-tagline">{{ site.tagline }}</p>
  </div>
  <div class="hero-down">↓ into the garden</div>
</header>

<main>
  {%- set latest = collections.posts | first %}
  {%- if latest %}
  <section class="section featured">
    <div class="section-label">Latest entry</div>
    <h2><a href="{{ latest.url }}">{{ latest.data.title }}</a></h2>
    <div class="post-meta">{{ latest.date | dmy }} &nbsp;·&nbsp; {{ latest.templateContent | readTime }} min read</div>
    <p>{{ latest.templateContent | excerpt(220) }}</p>
    <a class="read-more" href="{{ latest.url }}">Keep reading →</a>
  </section>
  {%- endif %}

  <section class="section section--wide" id="chronicle">
    <div class="section-label">The album</div>
    <p class="album-intro">Pinned to the wall — the latest from the garden. Tilt your head; that's allowed.</p>
    <div class="album-wall">
      {%- for post in collections.posts | head(12) %}
      <a class="polaroid" href="{{ post.url }}">
        <span class="polaroid-photo" data-seed="{{ post.data.title }}"></span>
        <span class="polaroid-caption">{{ post.data.title }}</span>
        <span class="polaroid-date">{{ post.date | dmy }}</span>
      </a>
      {%- endfor %}
    </div>
  </section>

  <section class="section" id="archive">
    <div class="section-label">The full chronicle</div>
    {%- for group in collections.postsByYear %}
    <div class="year-group">
      <div class="year-mark">{{ group.year }}</div>
      {%- for post in group.items %}
      <a class="entry" href="{{ post.url }}">
        <span class="entry-date">{{ post.date | dm }}</span>
        <span class="entry-title">{{ post.data.title }}</span>
      </a>
      {%- endfor %}
    </div>
    {%- endfor %}
  </section>

  <section class="section about" id="about">
    <div class="section-label" style="justify-content:center">About</div>
    <p>{{ site.description }}</p>
    <div class="sig">✶ {{ site.author }}</div>
  </section>
</main>

<script src="{{ '/assets/fireflies.js' }}" defer></script>
<script src="{{ '/assets/scenes.js' }}" defer></script>
